{
  "name": "@insuredesk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/routers/index.ts"
  },
  "scripts": {
    "dev": "node prisma/dev-init.ts && node --watch src/index.ts",
    "start": "node src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@insuredesk/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/fastify-api-reference": "^1.67.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "jszip": "^3.10.1",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^12.0.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
